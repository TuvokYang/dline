# Ignore all webview-ui files except the build directory (https://github.com/microsoft/vscode-webview-ui-toolkit-samples/blob/main/frameworks/hello-world-react-cra/.vscodeignore)
webview-ui/src/**
webview-ui/public/**
webview-ui/index.html
webview-ui/README.md
webview-ui/package.json
webview-ui/package-lock.json
webview-ui/node_modules/**
webview-ui/.vite-port
webview-ui/.storybook/**
webview-ui/storybook-static/**
webview-ui/components.json
webview-ui/tailwind.config.mjs
webview-ui/tsconfig*.json
**/.gitignore

# Ignore docs
docs/**
old_docs/**

# Include default themes JSON files used in getTheme
!src/integrations/theme/default-themes/**

# Include icons
assets/icons/**
!assets/icons/icon.png
!assets/icons/icon.svg
!assets/icons/cline-bot.woff

# Ignore E2E build files
e2e-build.mjs
e2e.vsix
test-results/
.playwright-mcp/
# Cross-process guard for the shared dist/ build output. It is live exactly when
# an E2E build packages dist/, so it must never become extension content.
dist/.e2e-lock/

# Ignore SDK and temp files
tmp_sdk_check/
tmp/
dist/tmp/
# Diagnostic bundles and other archives dropped at the repository root
*.zip
# Ignore tests
tests/

# Ignore Storybook files
**/*.stories.tsx
*storybook.log
storybook-static
**/StorybookDecorator.tsx

# memory bank for dline development
.memory-bank/

# for AI agents
.codex/
.claude/
.agents/
.wt/
