					"expr": "sum(count_over_time({service_name=\"dline\",service_instance_id=~\"$instance\"} |= \"api.request.failed\" | telemetry_channel=\"runtime\" | canary_id!~\".+\" | task_snapshot_durable_available=\"false\" | provider=~\"$provider\" | model=~\"$model\" | api_format=~\"$apiFormat\" | error_status=~\"$status\" | error_code=~\"$errorCode\" [$__range]))",
