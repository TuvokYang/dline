	"description": "Dline API and runtime error forensics. Loki panels show correlated task state, durable snapshot and usage fields without raw task content. Paste an exact 32-character trace ID into traceId to render the Tempo waterfall. Production panels exclude explicit live canaries by default.",
	"editable": true,
	"fiscalYearStartMonth": 0,
	"graphTooltip": 1,
	"id": null,
	"links": [],
	"liveNow": false,
	"panels": [
		{
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"fieldConfig": {
				"defaults": {
					"color": {
						"mode": "thresholds"
					},
					"mappings": [],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "red",
								"value": 1
							}
						]
					},
					"unit": "short"
				},
				"overrides": []
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 0,
				"y": 0
			},
			"id": 1,
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto",
				"orientation": "auto",
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"showPercentChange": false,
				"textMode": "auto",
				"wideLayout": true
			},
			"pluginVersion": "10.0.0",
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"expr": "sum(increase(dline_runtime_operation_duration_count{canary_id!~\".+\",operation=\"api.request\",outcome=\"failed\",provider=~\"$provider\",model=~\"$model\",api_format=~\"$apiFormat\"}[$__range]))",
					"instant": true,
					"legendFormat": "Failures",
					"range": false,
					"refId": "A"
				}
			],
			"title": "Failed API Invocations",
			"type": "stat"
		},
		{
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"fieldConfig": {
				"defaults": {
					"color": {
						"mode": "thresholds"
					},
					"mappings": [],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "yellow",
								"value": 5
							},
							{
								"color": "red",
								"value": 15
							}
						]
					},
					"unit": "percent"
				},
				"overrides": []
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 4,
				"y": 0
			},
			"id": 2,
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto",
				"orientation": "auto",
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"showPercentChange": false,
				"textMode": "auto",
				"wideLayout": true
			},
			"pluginVersion": "10.0.0",
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"expr": "100 * sum(increase(dline_runtime_operation_duration_count{canary_id!~\".+\",operation=\"api.request\",outcome=\"failed\",provider=~\"$provider\",model=~\"$model\",api_format=~\"$apiFormat\"}[$__range])) / sum(increase(dline_runtime_operation_duration_count{canary_id!~\".+\",operation=\"api.request\",outcome=~\"completed|failed\",provider=~\"$provider\",model=~\"$model\",api_format=~\"$apiFormat\"}[$__range]))",
					"instant": true,
					"legendFormat": "Failure ratio",
					"range": false,
					"refId": "A"
				}
			],
			"title": "API Failure Ratio",
			"type": "stat"
		},
