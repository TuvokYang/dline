						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(dline_runtime_operation_duration_bucket{canary_id!~\".+\",bucket_schema=\"v2\",operation=\"api.request\",outcome=\"failed\",provider=~\"$provider\",model=~\"$model\",api_format=~\"$apiFormat\"}[$__rate_interval])))",
					"instant": true,
					"legendFormat": "Failed p95",
					"range": false,
