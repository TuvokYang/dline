---
/**
 * Tabs for the documentation sections (User Guide, Developer Guide). Each tab
 * opens the first page of its section; the current section is highlighted.
 */
const tabs = Astro.locals.dlineSections ?? []
const isChinese = Astro.locals.starlightRoute.lang.toLowerCase().startsWith("zh")
const label = isChinese ? "文档分区" : "Documentation sections"
---

{
	tabs.length > 0 && (
		<nav class="section-tabs print:hidden" aria-label={label}>
			<ul>
				{tabs.map((tab) => (
					<li>
						<a href={tab.href} aria-current={tab.isCurrent ? "true" : undefined}>
							{tab.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	.section-tabs {
		flex: 1;
		display: flex;
		min-height: 0;
	}
	ul {
		display: flex;
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
	}
	a {
		display: flex;
		align-items: center;
		border-bottom: 2px solid transparent;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	a[aria-current="true"] {
		border-bottom-color: var(--sl-color-text-accent);
		color: var(--sl-color-text-accent);
	}
	a:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
</style>
