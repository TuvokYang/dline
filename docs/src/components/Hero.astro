---
/** Compact splash heading; PageFrame owns the shared corner mascot. */
import Default from "@astrojs/starlight/components/Hero.astro"
---

<div class="dline-hero">
	<Default />
</div>

<style>
	.dline-hero > :global(.hero) {
		grid-template-columns: 1fr;
		padding-block: 0.75rem;
	}
	.dline-hero :global(.copy) {
		gap: 0.75rem;
	}
	.dline-hero :global(h1) {
		font-size: 3rem;
	}
	.dline-hero :global(.tagline) {
		max-width: none;
		font-size: 1.25rem;
	}
	@media (max-width: 49.99rem) {
		.dline-hero :global(h1) {
			font-size: 2rem;
		}
		.dline-hero :global(.tagline) {
			font-size: 1rem;
		}
	}
</style>
