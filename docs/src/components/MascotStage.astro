---
/**
 * The live 3D mascot. The stage is a button: activating it replays the
 * warm-up routine. The three.js module loads lazily on wide screens, where
 * splash pages and the table-of-contents column leave room in the corner.
 */
const route = Astro.locals.starlightRoute
const isChinese = route.lang.toLowerCase().startsWith("zh")
const label = isChinese ? "Dline 机器人：点击重播热身操" : "Dline robot: click to replay its warm-up"
const hasRoom = route.entry.data.template === "splash" || Boolean(route.toc)
---

{hasRoom && <button type="button" class="dline-mascot" aria-label={label} title={label} hidden />}

<script>
	import { showMascotWhen } from "../mascot/lazy-mount.js"

	const stage = document.querySelector<HTMLButtonElement>(".dline-mascot")
	if (stage) {
		const mascot = showMascotWhen(stage, "(min-width: 72rem)")
		stage.addEventListener("click", () => mascot.replay())
	}
</script>

<style>
	/*
	 * Article pages scale the stage with the shorter viewport edge; the splash
	 * page supplies a smaller size and reserves room beside its entry cards.
	 */
	.dline-mascot {
		position: fixed;
		inset-inline-end: 0.25rem;
		inset-block-end: 0.25rem;
		z-index: 1;
		width: var(--dline-mascot-size, clamp(12rem, 33vmin, 28rem));
		aspect-ratio: 1 / 1;
		padding: 0;
		border: 0;
		border-radius: 0.75rem;
		background: none;
		cursor: pointer;
	}
	.dline-mascot:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	@media (max-width: 71.99rem) {
		.dline-mascot {
			display: none;
		}
	}
	@media print {
		.dline-mascot {
			display: none;
		}
	}
</style>
