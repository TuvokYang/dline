{
	"name": "dline-docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Dline documentation site built with Astro Starlight and published to GitHub Pages.",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --base /",
		"dev:pages": "astro dev --base /dline/",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && node scripts/check-content.mjs",
		"check:dist": "node scripts/check-dist.mjs",
		"raden": "node scripts/generate-raden.mjs",
		"test": "node --test \"scripts/**/*.test.mjs\"",
		"verify": "npm run test && npm run check && npm run build && npm run check:dist",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/starlight": "^0.42.3",
		"astro": "^7.3.5",
		"sharp": "^0.35.4",
		"three": "0.180.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"typescript": "^6.0.3"
	}
}
